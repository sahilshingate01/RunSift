# RunSift environment configuration
# Copy this file to .env and fill in your credentials.

# Required: Your Nebius Token Factory API key
NEBIUS_API_KEY=your-token-factory-key

# Optional: Upstream API base URL
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# Optional: If set, clients must send this as a Bearer token or X-API-Key header
RUNSIFT_API_KEY=choose-a-gateway-key

# Optional: Condenser version (v1 | v2 | v2.1)
RUNSIFT_CONDENSER=v2